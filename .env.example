# URL pública del sitio — la usan sitemap, robots, OpenGraph y JSON-LD.
# En Vercel debe apuntar al dominio final.
NEXT_PUBLIC_SITE_URL=https://flamingoyachtclub.com

# App store links (Moxsea app)
NEXT_PUBLIC_WHATSAPP=34722454277
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/moxsea/id6738347482
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.moxsea

# Contact email destination
CONTACT_EMAIL=Hello@flamingoyachtclub.com

# — Envío de leads por email —
# Opción A (recomendada): SMTP de Hostinger con el buzón del club.
# Solo hace falta SMTP_PASS (la contraseña del buzón Hello@flamingoyachtclub.com);
# el resto tiene valores por defecto correctos para Hostinger.
# OJO: sin SMTP_PASS ni RESEND_API_KEY, en producción los formularios devuelven
# error 503 en vez de perder leads en silencio.
SMTP_PASS=contraseña-del-buzon
# SMTP_USER=Hello@flamingoyachtclub.com
# SMTP_HOST=smtp.hostinger.com
# SMTP_PORT=465

# Opción B: Resend (si algún día no se usa el buzón de Hostinger)
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Flamingo Yacht Club <onboarding@resend.dev>

# — Sanity (CMS de edición para el cliente) —
# Se crean en sanity.io/manage; ver PROXIMOS-PASOS.md
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Token con permiso Editor, SOLO para ejecutar la migración en local.
# No subir nunca a Vercel ni al repo.
# SANITY_API_WRITE_TOKEN=
# Secreto compartido con el webhook de Sanity → /api/revalidate
# SANITY_REVALIDATE_SECRET=
